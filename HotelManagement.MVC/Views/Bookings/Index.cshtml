@model IEnumerable<BookingViewModel>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                My Bookings
            </h1>

            <p class="text-muted mb-0">
                Your recent hotel reservations.
            </p>
        </div>

    </div>

    @if (Model.Any())
    {
        <div class="d-flex flex-column gap-4">

            @foreach (var booking in Model)
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                    <div class="card-body p-0">

                        <div class="row g-0">

                            <!-- Left Accent -->
                            <div class="col-lg-1 bg-dark d-none d-lg-flex align-items-center justify-content-center">

                                <i class="bi bi-building text-white fs-2"></i>

                            </div>

                            <!-- Main Content -->
                            <div class="col-lg-11">

                                <div class="p-4">

                                    <!-- Top -->
                                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">

                                        <div>

                                            <div class="d-flex align-items-center gap-2 mb-2">

                                                <h4 class="fw-bold mb-0">
                                                    @booking.HotelName
                                                </h4>

                                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                                                    @booking.RoomType
                                                </span>

                                            </div>

                                            <p class="text-muted mb-0">
                                                <i class="bi bi-geo-alt me-1"></i>
                                                @booking.HotelLocation
                                            </p>

                                        </div>

                                        <div class="text-lg-end">

                                            <h4 class="fw-bold mb-0">
                                                ₹@booking.TotalPrice
                                            </h4>

                                            <small class="text-muted">
                                                Total Amount
                                            </small>

                                        </div>

                                    </div>

                                    <!-- Compact Details -->
                                    <div class="row g-3 align-items-center">

                                        <div class="col-md-3">

                                            <div class="bg-light rounded-4 p-3 h-100">

                                                <small class="text-muted d-block mb-1">
                                                    Check In
                                                </small>

                                                <span class="fw-semibold">
                                                    @booking.CheckInDate.ToString("dd MMM yyyy")
                                                </span>

                                            </div>

                                        </div>

                                        <div class="col-md-3">

                                            <div class="bg-light rounded-4 p-3 h-100">

                                                <small class="text-muted d-block mb-1">
                                                    Check Out
                                                </small>

                                                <span class="fw-semibold">
                                                    @booking.CheckOutDate.ToString("dd MMM yyyy")
                                                </span>

                                            </div>

                                        </div>

                                        <div class="col-md-2">

                                            <div class="bg-light rounded-4 p-3 h-100">

                                                <small class="text-muted d-block mb-1">
                                                    Room
                                                </small>

                                                <span class="fw-semibold">
                                                    #@booking.RoomNumber
                                                </span>

                                            </div>

                                        </div>

                                        <div class="col-md-4">

                                            <div class="bg-light rounded-4 p-3 h-100">

                                                <small class="text-muted d-block mb-1">
                                                    Guest
                                                </small>

                                                <span class="fw-semibold">
                                                    @booking.GuestName
                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                    <!-- Amenities -->
                                    @if (booking.Amenities.Any())
                                    {
                                        <div class="mt-4">

                                            <div class="d-flex flex-wrap gap-2">

                                                @foreach (var amenity in booking.Amenities)
                                                {
                                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                                        @amenity.Name
                                                    </span>
                                                }

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5">

            <div class="mb-3">
                <i class="bi bi-calendar-x fs-1 text-muted"></i>
            </div>

            <h4 class="fw-semibold mb-2">
                No bookings yet
            </h4>

            <p class="text-muted mb-4">
                Start exploring hotels and reserve your stay.
            </p>

            <a asp-controller="Hotels"
               asp-action="Index"
               class="btn btn-dark rounded-pill px-4">

                Browse Hotels

            </a>

        </div>
    }

</div>
