@model HotelManagement.MVC.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- Top Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Admin Dashboard</h2>
            <p class="text-muted mb-0">
                Manage hotels, bookings, payments and more
            </p>
        </div>

    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small mb-2">Hotels</p>
                    <h3 class="fw-bold mb-0">@Model.Hotels.Count()</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small mb-2">Rooms</p>
                    <h3 class="fw-bold mb-0">@Model.Rooms.Count()</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small mb-2">Reservations</p>
                    <h3 class="fw-bold mb-0">@Model.Reservations.Count()</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small mb-2">Payments</p>
                    <h3 class="fw-bold mb-0">@Model.Payments.Count()</h3>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <!-- Sidebar -->
        <div class="col-lg-3 col-xl-2">

            <div class="card border-0 shadow-sm sticky-lg-top">

                <div class="card-body p-3">

                    <h6 class="text-uppercase fw-semibold mb-3 px-2">
                        Navigation
                    </h6>

                    <div class="nav nav-pills flex-column gap-2">

                        <button class="nav-link active rounded-3 text-start px-3 py-2"
                                data-bs-toggle="pill"
                                data-bs-target="#hotels">
                            <i class="bi bi-building me-2"></i>
                            Hotels
                        </button>

                        <button class="nav-link rounded-3 text-start px-3 py-2"
                                data-bs-toggle="pill"
                                data-bs-target="#rooms">
                            <i class="bi bi-door-open me-2"></i>
                            Rooms
                        </button>

                        <button class="nav-link rounded-3 text-start px-3 py-2"
                                data-bs-toggle="pill"
                                data-bs-target="#reservations">
                            <i class="bi bi-calendar-check me-2"></i>
                            Reservations
                        </button>

                        <button class="nav-link rounded-3 text-start px-3 py-2"
                                data-bs-toggle="pill"
                                data-bs-target="#payments">
                            <i class="bi bi-credit-card me-2"></i>
                            Payments
                        </button>

                        <button class="nav-link rounded-3 text-start px-3 py-2"
                                data-bs-toggle="pill"
                                data-bs-target="#reviews">
                            <i class="bi bi-star me-2"></i>
                            Reviews
                        </button>

                        <button class="nav-link rounded-3 text-start px-3 py-2"
                                data-bs-toggle="pill"
                                data-bs-target="#amenities">
                            <i class="bi bi-stars me-2"></i>
                            Amenities
                        </button>

                    </div>

                </div>

            </div>

        </div>

        <!-- Content -->
        <div class="col-lg-9 col-xl-10">

            <div class="tab-content">

                <!-- HOTELS -->
                <div class="tab-pane fade show active" id="hotels">

                    <div class="card border-0 shadow-sm">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-center mb-4">

                                <div>
                                    <h4 class="fw-bold mb-1">Hotels</h4>
                                    <p class="text-muted mb-0">
                                        Total Hotels: @Model.Hotels.Count()
                                    </p>
                                </div>

                            </div>

                            <div class="table-responsive">

                                <table class="table table-hover align-middle mb-0">

                                    <thead class="table-light">
                                        <tr>
                                            <th>Name</th>
                                            <th>Location</th>
                                            <th>Description</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var hotel in Model.Hotels)
                                        {
                                            <tr>

                                                <td class="fw-semibold">
                                                    @hotel.Name
                                                </td>

                                                <td class="text-muted">
                                                    @hotel.Location
                                                </td>

                                                <td class="text-muted">
                                                    @hotel.Description
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ROOMS -->
                <div class="tab-pane fade" id="rooms">

                    <div class="card border-0 shadow-sm">

                        <div class="card-body p-4">

                            <h4 class="fw-bold mb-4">Rooms</h4>

                            <div class="table-responsive">

                                <table class="table table-hover align-middle mb-0">

                                    <thead class="table-light">
                                        <tr>
                                            <th>Room No.</th>
                                            <th>Room Type</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var room in Model.Rooms)
                                        {
                                            <tr>

                                                <td class="fw-semibold">
                                                    @room.RoomNumber
                                                </td>

                                                <td>@room.RoomTypeName</td>

                                                <td>

                                                    @if (room.IsAvailable)
                                                    {
                                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                                            Available
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger rounded-pill px-3 py-2">
                                                            Occupied
                                                        </span>
                                                    }

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- RESERVATIONS -->
                <div class="tab-pane fade"
                     id="reservations">

                    <div class="card border-0 shadow-sm rounded-4">

                        <div class="card-body p-4">

                            <h3 class="fw-bold mb-4">
                                Reservations
                            </h3>

                            <div class="table-responsive">

                                <table class="table align-middle">

                                    <thead>
                                        <tr>
                                            <th>Guest</th>
                                            <th>Email</th>
                                            <th>Check In</th>
                                            <th>Check Out</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var reservation in Model.Reservations)
                                        {
                                            <tr>

                                                <td class="fw-semibold">
                                                    @reservation.GuestName
                                                </td>

                                                <td>@reservation.GuestEmail</td>

                                                <td>@reservation.CheckInDate</td>

                                                <td>@reservation.CheckOutDate</td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- PAYMENTS -->
                <div class="tab-pane fade"
                     id="payments">

                    <div class="card border-0 shadow-sm rounded-4">

                        <div class="card-body p-4">

                            <h3 class="fw-bold mb-4">
                                Payments
                            </h3>

                            <div class="table-responsive">

                                <table class="table align-middle">

                                    <thead>
                                        <tr>
                                            <th>Reservation</th>
                                            <th>Amount</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var payment in Model.Payments)
                                        {
                                            <tr>

                                                <td>@payment.ReservationId</td>

                                                <td class="fw-semibold">
                                                    ₹@payment.Amount
                                                </td>

                                                <td>

                                                    <span class="badge bg-dark rounded-pill px-3 py-2">
                                                        @payment.PaymentStatus
                                                    </span>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- REVIEWS -->
                <div class="tab-pane fade" id="reviews">

                    <div class="card border-0 shadow-sm">

                        <div class="card-body p-4">

                            <h4 class="fw-bold mb-4">Reviews</h4>

                            <div class="d-flex flex-column gap-3">

                                @foreach (var review in Model.Reviews)
                                {
                                    <div class="card border-0 bg-light">

                                        <div class="card-body">

                                            <div class="d-flex justify-content-between align-items-center mb-3">

                                                <span class="badge bg-dark rounded-pill px-3 py-2">
                                                    ⭐ @review.Rating
                                                </span>

                                                <small class="text-muted">
                                                    @review.ReviewDate
                                                </small>

                                            </div>

                                            <p class="text-muted mb-0">
                                                @review.Comment
                                            </p>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </div>

                <!-- AMENITIES -->
                <div class="tab-pane fade" id="amenities">

                    <div class="card border-0 shadow-sm">

                        <div class="card-body p-4">

                            <h4 class="fw-bold mb-4">Amenities</h4>

                            <div class="row g-4">

                                @foreach (var amenity in Model.Amenities)
                                {
                                    <div class="col-md-6 col-xl-4">

                                        <div class="card border-0 bg-light h-100">

                                            <div class="card-body">

                                                <h6 class="fw-semibold mb-2">
                                                    @amenity.Name
                                                </h6>

                                                <p class="text-muted mb-0">
                                                    @amenity.Description
                                                </p>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>